<?xml version="1.0" encoding="utf-8"?>
<!-- Owned by PLATFORM. No INTERNET permission, ever (brief section 0, rule 3). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Allowed set only (T-PLATFORM-1). Forbidden: INTERNET, ACCESS_NETWORK_STATE, QUERY_ALL_PACKAGES,
         READ_PHONE_STATE, location, contacts, accessibility. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets the UI list launchable apps without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".platform.JixxyApp"
        android:allowBackup="false"
        android:label="Jixxy"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".platform.LauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- specialUse: no standard foreground-service type fits a floating companion sprite.
             Type + PROPERTY_SPECIAL_USE_FGS_SUBTYPE per Android docs (property API 34+). -->
        <service
            android:name=".platform.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows a user-enabled floating companion sprite over other apps; started and stopped by the user." />
        </service>

        <!-- Share cards written by UI to cacheDir/share/ (res/xml/file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".platform.NotificationActionReceiver"
            android:exported="false" />
    </application>
</manifest>
