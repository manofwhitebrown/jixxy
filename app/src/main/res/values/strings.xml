    <string name="ob_hello_title">[P] Hi. I\'m Jixxy.</string>
    <string name="ob_hello_body">[P] I live on your screen and help you pause before the apps you choose.</string>
    <string name="ob_overlay_title">[P] Why I need to sit on your apps</string>
    <string name="ob_overlay_body">[P] Android calls it "display over other apps". It lets me appear on top so I can show up.</string>
    <string name="ob_usage_title">[P] Why I need to see which app is open</string>
    <string name="ob_usage_body">[P] I only see the NAME of the open app. Never what is inside it.</string>
    <string name="ob_cant_do">[P] What I can\'t do: use the internet, read your messages, take screenshots.</string>
