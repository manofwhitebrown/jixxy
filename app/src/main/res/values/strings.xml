    <string name="ob_restricted_steps">[P] Tap the switch, then open App info, then the \u22ee menu, then "Allow restricted settings", then come back.</string>
    <string name="ob_restricted_hedge">[P] Menus differ by phone and Android version.</string>
    <string name="ob_notif_title">[P] Notifications</string>
    <string name="ob_notif_body">[P] Only so Android lets me keep running. No spam.</string>
    <string name="ob_keepalive_title">[P] Keep me alive</string>
    <string name="ob_keepalive_body">[P] Some phones put apps to sleep. A couple of settings stop that.</string>
